
{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stored user profile information and balance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "coins": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "email", "coins", "role"]
    },
    "Admin": {
      "title": "Admin Account",
      "description": "Authorized administrator accounts.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "TrafficOrder": {
      "title": "Traffic Order",
      "description": "Order for Shopee or TikTok views.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "platform": { "type": "string", "enum": ["shopee", "tiktok"] },
        "url": { "type": "string" },
        "views": { "type": "number" },
        "coinCost": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CoinTransaction": {
      "title": "Coin Transaction",
      "description": "History of coin usage or addition.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["topup", "purchase", "referral_bonus", "traffic_order"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TopUpRequest": {
      "title": "Top Up Request",
      "description": "User request to add coins via manual transfer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amountCoins": { "type": "number" },
        "idrAmount": { "type": "number" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ApiSettings": {
      "title": "API Configuration",
      "description": "Settings for external booster API services.",
      "type": "object",
      "properties": {
        "apiUrl": { "type": "string" },
        "apiKey": { "type": "string" },
        "serviceId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profile documents"
    },
    "/admins/{adminId}": {
      "schema": "#/entities/Admin",
      "description": "Administrator accounts with panel access"
    },
    "/traffic_orders/{orderId}": {
      "schema": "#/entities/TrafficOrder",
      "description": "Traffic boosting orders"
    },
    "/coin_transactions/{txId}": {
      "schema": "#/entities/CoinTransaction",
      "description": "Transaction history"
    },
    "/topup_requests/{requestId}": {
      "schema": "#/entities/TopUpRequest",
      "description": "Manual coin top-up requests"
    },
    "/settings/api": {
      "schema": "#/entities/ApiSettings",
      "description": "System API configuration"
    }
  }
}
