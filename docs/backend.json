
{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stored user profile information and balance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "coins": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "role": { "type": "string", "enum": ["user", "admin", "premium", "private", "vip", "mbah paijo"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "email", "coins", "role"]
    },
    "Admin": {
      "title": "Admin Account",
      "description": "Authorized administrator accounts.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "assistant_admin", "admin"] },
        "coins": { "type": "number", "description": "Balance for Sub Admin operation" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "SubAdminCoinHistory": {
      "title": "Sub Admin Coin History",
      "description": "Log of coin transfers between Master and Sub Admins.",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string" },
        "adminEmail": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["add", "sub"] },
        "processedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TrafficOrder": {
      "title": "Traffic Order",
      "description": "Order for Shopee or TikTok views.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "platform": { "type": "string", "enum": ["shopee", "tiktok"] },
        "url": { "type": "string" },
        "views": { "type": "number" },
        "coinCost": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "COMPLETED", "PARTIAL", "CANCELLED", "FAILED"] },
        "providerOrderId": { "type": "string" },
        "serviceLabel": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CoinTransaction": {
      "title": "Coin Transaction",
      "description": "History of coin usage or addition.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["topup", "purchase", "traffic_order"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TopUpRequest": {
      "title": "Top Up Request",
      "description": "User request to add coins via manual transfer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amountCoins": { "type": "number" },
        "idrAmount": { "type": "number" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profile documents"
    },
    "/admins/{adminId}": {
      "schema": "#/entities/Admin",
      "description": "Administrator accounts with panel access"
    },
    "/traffic_orders/{orderId}": {
      "schema": "#/entities/TrafficOrder",
      "description": "Traffic boosting orders"
    },
    "/coin_transactions/{txId}": {
      "schema": "#/entities/CoinTransaction",
      "description": "Transaction history"
    },
    "/topup_requests/{requestId}": {
      "schema": "#/entities/TopUpRequest",
      "description": "Manual coin top-up requests"
    },
    "/sub_admin_coin_history/{txId}": {
      "schema": "#/entities/SubAdminCoinHistory",
      "description": "History of sub-admin balance changes"
    }
  }
}
