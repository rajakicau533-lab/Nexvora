
{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stored user profile information and balance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "coins": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "role": { "type": "string", "enum": ["user", "admin", "premium", "private", "vip", "mbah paijo"] },
        "referralCode": { "type": "string", "description": "Unique code for inviting others" },
        "referredBy": { "type": "string", "description": "UID of the user who invited this person" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "email", "coins", "role"]
    },
    "InjectAdsCampaign": {
      "title": "Inject Ads Campaign",
      "description": "Premium advertising optimization campaign for Shopee Video.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "profileLink": { "type": "string" },
        "videoLink": { "type": "string" },
        "durationLabel": { "type": "string" },
        "rateLabel": { "type": "string" },
        "totalCost": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "schedules": { "type": "array", "items": { "type": "object" } },
        "regions": { "type": "array", "items": { "type": "string" } },
        "startedAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" }
      }
    },
    "MarketplaceProduct": {
      "title": "Marketplace Product",
      "description": "Digital products available for purchase with coins.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "priceCoins": { "type": "number" },
        "imageUrls": { "type": "array", "items": { "type": "string" } },
        "downloadUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "priceCoins", "downloadUrl"]
    },
    "MarketplacePurchase": {
      "title": "Marketplace Purchase",
      "description": "User purchase records for digital products.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "amountCoins": { "type": "number" },
        "downloadUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Admin": {
      "title": "Admin Account",
      "description": "Authorized administrator accounts.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "assistant_admin", "admin"] },
        "coins": { "type": "number", "description": "Balance for Sub Admin operation" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "TrafficOrder": {
      "title": "Traffic Order",
      "description": "Order for Shopee or TikTok views.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "platform": { "type": "string", "enum": ["shopee", "tiktok", "facebook", "instagram"] },
        "url": { "type": "string" },
        "views": { "type": "number" },
        "coinCost": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "COMPLETED", "PARTIAL", "CANCELLED", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CoinTransaction": {
      "title": "Coin Transaction",
      "description": "History of coin usage or addition.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["topup", "purchase", "traffic_order"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TopUpRequest": {
      "title": "Top Up Request",
      "description": "User request to add coins via manual transfer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amountCoins": { "type": "number" },
        "idrAmount": { "type": "number" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ReferralRecord": {
      "title": "Referral Record",
      "description": "Log of successful user invitations.",
      "type": "object",
      "properties": {
        "referralOwnerId": { "type": "string" },
        "referralOwnerEmail": { "type": "string" },
        "referralCode": { "type": "string" },
        "referredUserId": { "type": "string" },
        "referredUsername": { "type": "string" },
        "referredEmail": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "BoostKlik": {
      "title": "Boost Klik Link",
      "description": "Custom image-to-redirect links for boosting clicks.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "imageUrl": { "type": "string" },
        "targetUrl": { "type": "string" },
        "shortCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "NexTitleHistory": {
      "title": "NexTitle SEO History",
      "description": "Historical records of generated SEO content for users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "judul": { "type": "string" },
        "bahan": { "type": "string" },
        "hook": { "type": "string" },
        "captions": { "type": "array", "items": { "type": "string" } },
        "hashtags": { "type": "string" },
        "hookPros": { "type": "array", "items": { "type": "string" } },
        "coinUsed": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profile documents"
    },
    "/admins/{adminId}": {
      "schema": "#/entities/Admin",
      "description": "Administrator accounts"
    },
    "/marketplace_products/{productId}": {
      "schema": "#/entities/MarketplaceProduct",
      "description": "Catalog of digital products"
    },
    "/marketplace_purchases/{purchaseId}": {
      "schema": "#/entities/MarketplacePurchase",
      "description": "User digital product purchases"
    },
    "/traffic_orders/{orderId}": {
      "schema": "#/entities/TrafficOrder",
      "description": "Traffic boosting orders"
    },
    "/coin_transactions/{txId}": {
      "schema": "#/entities/CoinTransaction",
      "description": "Transaction history"
    },
    "/topup_requests/{requestId}": {
      "schema": "#/entities/TopUpRequest",
      "description": "Manual coin top-up requests"
    },
    "/referral_history/{recordId}": {
      "schema": "#/entities/ReferralRecord",
      "description": "History of successful referrals"
    },
    "/boostKlik/{id}": {
      "schema": "#/entities/BoostKlik",
      "description": "Boost Klik short links"
    },
    "/nextitle_history/{recordId}": {
      "schema": "#/entities/NexTitleHistory",
      "description": "History of generated SEO content"
    },
    "/inject_ads_campaigns/{id}": {
      "schema": "#/entities/InjectAdsCampaign",
      "description": "Premium ad optimization campaigns"
    }
  }
}
