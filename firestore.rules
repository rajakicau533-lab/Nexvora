rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Check if user is an admin by looking at the admins collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // PROFILE USER
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null; // Allow listing for admin checks/search
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      // Crucial: Allow a user to READ their own admin document to verify their role
      allow get: if request.auth != null && request.auth.uid == adminId;
      // Allow the master admin to create their own record during setup/login
      allow create: if request.auth != null && request.auth.uid == adminId;
      // All other operations require existing admin status
      allow read, write: if isAdmin();
    }

    // TRAFFIC ORDERS
    match /traffic_orders/{orderId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // COIN TRANSACTIONS
    match /coin_transactions/{txId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // TOPUP REQUESTS
    match /topup_requests/{requestId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // MATERIALS
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // MARKETPLACE
    match /marketplace_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /marketplace_purchases/{purchaseId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}