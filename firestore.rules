
// Deployment Timestamp: 2024-05-22
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Check if user is an admin or is the master developer
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "adheprogramer@gmail.com"
      );
    }

    // Check if user is a super admin
    function isSuperAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin') ||
        request.auth.token.email == "adheprogramer@gmail.com"
      );
    }

    // PROFILE USER
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if (request.auth == null && request.query.limit == 1) || isAdmin() || (request.auth != null && request.query.limit <= 100);
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if isSuperAdmin();
      allow update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      allow get: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && (request.auth.token.email == "adheprogramer@gmail.com" || isSuperAdmin());
      allow update: if request.auth != null && (
        request.auth.uid == adminId || // Allow admin to update their own coins/data
        isSuperAdmin() || 
        request.auth.token.email == "adheprogramer@gmail.com"
      );
      allow delete: if isSuperAdmin();
    }

    // TRAFFIC ORDERS
    match /traffic_orders/{orderId} {
      allow read: if (request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || (request.auth == null && request.resource.data.isFromSchedule == true);
      allow update, delete: if isAdmin();
    }

    // COIN TRANSACTIONS
    match /coin_transactions/{txId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if (request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin())) || (request.auth == null);
      allow update, delete: if isAdmin();
    }

    // SUB ADMIN COIN HISTORY
    match /sub_admin_coin_history/{txId} {
      allow read: if isAdmin();
      allow create: if isSuperAdmin() || (request.auth != null && request.auth.uid == request.resource.data.adminUid);
    }

    // TOPUP REQUESTS
    match /topup_requests/{requestId} {
      allow read: if (request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // AI ERROR LOGS
    match /ai_error_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    // MATERIALS
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // MARKETPLACE
    match /marketplace_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /marketplace_purchases/{purchaseId} {
      allow read: if (request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // SYSTEM SETTINGS
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (request.auth != null && request.auth.token.email == "adheprogramer@gmail.com") || (request.auth == null);
    }
    
    // ACTIVITY LOGS
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    // API LOGS
    match /api_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null || request.auth == null;
      allow delete: if isAdmin();
    }
  }
}
