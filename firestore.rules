rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Check if user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if user is a super admin
    function isSuperAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // PROFILE USER
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      allow update: if isAdmin(); 
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      // Allow a user to check their own admin status
      allow get: if request.auth != null && request.auth.uid == adminId;
      
      // Allow admins to see the team list
      allow list: if isAdmin();
      
      // Special bootstrap permission for the master developer email
      allow create, update: if request.auth != null && (
        (request.auth.token.email == "adheprogramer@gmail.com" && request.auth.uid == adminId) || 
        isSuperAdmin()
      );
      
      // Only Super Admins can delete other admin records
      allow delete: if isSuperAdmin();
    }

    // TRAFFIC ORDERS
    match /traffic_orders/{orderId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // COIN TRANSACTIONS
    match /coin_transactions/{txId} {
      // Allow user to read their own, or admin to read all
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      // Allow user to create for themselves, or admin to create for anyone
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // TOPUP REQUESTS
    match /topup_requests/{requestId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // MATERIALS
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // MARKETPLACE
    match /marketplace_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /marketplace_purchases/{purchaseId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ACTIVITY LOGS
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }
  }
}