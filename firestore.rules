
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Check if user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // PROFILE USER
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if true; 
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      // Perbaikan: Izinkan user membaca dokumen admin miliknya sendiri untuk verifikasi login
      allow get: if request.auth != null && request.auth.uid == adminId;
      // Operasi lainnya (list, write) hanya untuk admin yang sudah terverifikasi
      allow read, write: if isAdmin();
    }

    // TRAFFIC ORDERS
    match /traffic_orders/{orderId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // COIN TRANSACTIONS
    match /coin_transactions/{txId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // TOPUP REQUESTS
    match /topup_requests/{requestId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // MATERIALS
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if true; // Izinkan pembacaan setting publik jika perlu
      allow write: if isAdmin();
    }

    // MARKETPLACE
    match /marketplace_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /marketplace_purchases/{purchaseId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
