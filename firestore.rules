
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "adheprogramer@gmail.com"
      );
    }

    function isSuperAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin') ||
        request.auth.token.email == "adheprogramer@gmail.com"
      );
    }

    match /users/{userId} {
      allow read, list: if true; 
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /admins/{adminId} {
      allow get: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSuperAdmin() || request.auth.token.email == "adheprogramer@gmail.com";
      allow delete: if isSuperAdmin();
    }

    match /marketplace_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /marketplace_purchases/{purchaseId} {
      allow read: if (request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /traffic_orders/{orderId} {
      allow read: if (request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /coin_transactions/{txId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /topup_requests/{requestId} {
      allow read: if (request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /referral_history/{recordId} {
      allow read: if request.auth != null; 
      allow create: if request.auth != null || request.auth == null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    match /api_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }
    
    match /sub_admin_coin_history/{txId} {
      allow read: if isAdmin();
      allow create: if isSuperAdmin();
    }

    match /boostKlik/{id} {
      allow read, list: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /nextitle_history/{recordId} {
      allow read, list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /inject_ads_campaigns/{id} {
      allow read, list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /profile_traffic_campaigns/{id} {
      allow read, list: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
